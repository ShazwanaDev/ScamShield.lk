# ML artifacts (large binary files - don't commit to git)
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.bin
ml/models/*.safetensors
ml/models/mbert_checkpoint/
# Real collected messages are personal inbox content. Never commit them, or
# anything derived from them that contains message text.
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/

