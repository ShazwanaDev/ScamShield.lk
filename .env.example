# Copy this file to .env, next to docker-compose.yml, and fill in the values. Never commit .env itself.
#
# docker-compose.yml reads SECRET_KEY and ADMIN_PASSWORD from .env. Inside Docker it sets the database
# and Redis addresses itself, so the last two settings are only needed when the backend runs outside
# Docker (flask --app app run). The model files are always loaded from ml/models; there is no setting.

# Signs admin sign-in tokens. Use a long random value, for example the output of
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me
# The admin console passphrase, checked by the backend. Admin sign-in is off while it's empty.
ADMIN_PASSWORD=

# Only for running the backend outside Docker. These match the database that docker-compose.yml creates.
DATABASE_URL=postgresql://scamshield:scamshield@localhost:5432/scamshield
REDIS_URL=redis://localhost:6379/0
