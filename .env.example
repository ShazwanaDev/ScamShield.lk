# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres
POSTGRES_USER=scamshield
POSTGRES_PASSWORD=change_me
POSTGRES_DB=scamshield_lk
DATABASE_URL=postgresql://scamshield:change_me@localhost:5432/scamshield_lk

# Redis
REDIS_URL=redis://localhost:6379/0

# Flask
FLASK_APP=app.py
FLASK_ENV=development
# Signs admin sign-in tokens. Use a long random value, for example the output of
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_too
# The admin console passphrase, checked by the backend. Admin sign-in is off while it's empty.
ADMIN_PASSWORD=

# Model paths (relative to backend/)
MODEL_PATH=../ml/models/tfidf_logreg.pkl
VECTORIZER_PATH=../ml/models/tfidf_vectorizer.pkl
