# Copy to .env (or .env.local) and fill in real values. Never commit .env itself.

# Base URL of the Flask API, including the /api prefix.
VITE_API_URL=http://localhost:5000/api

# Passphrase gate for /admin/moderation. This is a client-side-only deterrent — it ships
# inside the built JS bundle and is NOT real access control. The backend /api/moderate*
# routes have no server-side auth yet; add that before any real deployment.
VITE_ADMIN_PASSPHRASE=change_me
