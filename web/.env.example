# Copy to .env (or .env.local) and fill in real values. Never commit .env itself.

# Base URL of the Flask API, including the /api prefix.
VITE_API_URL=http://localhost:5000/api

# There is no admin passphrase here on purpose: anything in a VITE_ variable ships inside
# the built JavaScript. The admin passphrase is the backend's ADMIN_PASSWORD setting.
